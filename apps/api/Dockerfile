FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
# The openapi.json is generated by the development build, not in the image.
ENV OpenApiGenerateDocuments=false
COPY dotnet-tools.json ./
RUN dotnet tool restore
COPY apps/api/src/Casarme.Api/Casarme.Api.csproj apps/api/src/Casarme.Api/
RUN dotnet restore apps/api/src/Casarme.Api
COPY apps/api/ apps/api/
RUN dotnet publish apps/api/src/Casarme.Api -c Release -o /out --no-restore
RUN dotnet ef migrations bundle --project apps/api/src/Casarme.Api -o /bundle/efbundle

# Runs the domain schema migrations and exits; the api never migrates on startup.
FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS migrate
WORKDIR /app
COPY --from=build /bundle/efbundle .
COPY --from=build /out/appsettings.json .
ENTRYPOINT ["./efbundle"]

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS api
WORKDIR /app
COPY --from=build /out .
EXPOSE 8080
ENTRYPOINT ["dotnet", "Casarme.Api.dll"]
