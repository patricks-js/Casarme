{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "tasks": {
    "openapi": {
      "inputs": ["**/*.cs", "**/*.csproj", "!bin/**", "!obj/**"],
      "outputs": ["openapi.json"]
    },
    "generate": {
      "dependsOn": ["^openapi"],
      "inputs": ["openapi-ts.config.ts", "../../apps/api/openapi.json"],
      "outputs": ["src/generated/**"]
    },
    "build": {
      "dependsOn": ["^generate", "generate", "^build"],
      "outputs": ["dist/**", ".output/**", "bin/**", "obj/**"]
    },
    "typecheck": {
      "dependsOn": ["^generate", "generate"]
    },
    "dev": {
      "dependsOn": ["^generate"],
      "cache": false,
      "persistent": true
    },
    "migrate": {
      "cache": false
    }
  }
}
