{
  "name": "casarme",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@tanstack/react-query": "5.107.1",
      "@types/bun": "1.4.4",
      "better-auth": "1.7.23",
      "typescript": "7.0.2",
      "zod": "4.6.7"
    }
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "generate": "turbo run generate",
    "db:migrate": "turbo migrate",
    "format": "bun fmt && dotnet format apps/api/Casarme.slnx",
    "format:check": "bun fmt --check && dotnet format apps/api/Casarme.slnx --verify-no-changes",
    "prepare": "lefthook install || true"
  },
  "devDependencies": {
    "lefthook": "2.2.2",
    "turbo": "2.11.10"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.4"
    },
    "runtime": {
      "name": "bun",
      "version": "1.4.4"
    }
  }
}
